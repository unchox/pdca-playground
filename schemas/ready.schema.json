{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ready.schema.json",
  "title": "PDCA intake floor — what a task must state before entering the loop",
  "type": "object",
  "required": ["task_id", "domain", "goal", "constraints", "artifact_target"],
  "properties": {
    "task_id": { "type": "string", "minLength": 1 },
    "domain": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "constraints": { "type": "array", "items": { "type": "string" } },
    "artifact_target": { "type": "string", "minLength": 1 }
  }
}
